# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# Generated files
# You might want to include or exclude the gen directory based on your workflow
# gen/

# Logs
*.log
logs/
log/

# Database files
*.db
*.sqlite
*.sqlite3

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Temporary files
tmp/
temp/

# PEM files (since you have private.pem and public.pem in your project)
*.pem

# Any backup files
*.bak

# Build output
bin/
dist/
build/

# Application specific
# Add any other application specific files or directories here